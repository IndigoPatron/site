jQuery.event.special.touchstart = {
  setup: function( _, ns, handle ){
    if ( ns.includes("noPreventDefault") ) {
      this.addEventListener("touchstart", handle, { passive: false });
    } else {
      this.addEventListener("touchstart", handle, { passive: true });
    }
  }
};	



/*Кнопки*/
jQuery(document).ready(function ($) {
	

    $('.connect-links').click(function(){
		$('.connect-links').toggleClass('upconnect');
    });
	

	
});










/*main */

"use strict";
jQuery(document).ready(function ($) {

		/*
        // Открываем первый элемент по умолчанию
        $("#faq-accordion .faq-item:first").addClass("active").find("p").show();
        
        // Обработчик клика для заголовков
        $("#faq-accordion").on("click", ".faq-item", function() {
			console.log("faq3");
            var $faqItem = $(this).closest(".faq-item");

            // Закрываем все элементы
            $("#faq-accordion .faq-item").removeClass("active").find("p").slideUp();
            
            // Если текущий элемент не был открыт, открываем его
            if (!$faqItem.hasClass("active")) {
                $faqItem.addClass("active").find("p").slideDown();
            }
        });
		*/

        // Открываем первый элемент по умолчанию
        $("#faq-accordion .faq-item:first").addClass("active").find("p").show();
		$("#faq-accordion .faq-item:not(:first-of-type)").removeClass("active").find("p").hide();
		
        // Обработчик клика для заголовков
        $("#faq-accordion").on("click", ".faq-item", function() {


			var $faqItem = $(this);
            // Закрываем все элементы
            $("#faq-accordion .faq-item").removeClass("active").find("p").hide();
            
            // Если текущий элемент не был открыт, открываем его
            if (!$faqItem.hasClass("active")) {
                $faqItem.addClass("active").find("p").show();
            }
        });











//for Preloader

    $(window).load(function () {
        $("#loading").fadeOut(500);
    });


    /*---------------------------------------------*
     * Mobile menu
     ---------------------------------------------*/
	 
	 /*
    $('.overlay').click(function () {
        if (location.pathname.replace(/^\//, '') == this.pathname.replace(/^\//, '') && location.hostname == this.hostname) {
            var target = $(this.hash);
            target = target.length ? target : $('[name=' + this.hash.slice(1) + ']');
            if (target.length) {
                $('html,body').animate({
                    scrollTop: (target.offset().top - 80)
                }, 1000);
                if ($('.navbar-toggle').css('display') != 'none') {
                    $(this).parents('.container').find(".navbar-toggle").trigger("click");
                }
                return false;
            }
        }
    });
	*/
	
	 if($(window).innerWidth() < 1100){
		 $('#overlay a').click(function () {
				$('#overlay').css('visibility', 'hidden').show(1000);
				// $("#overlay-input").attr('checked','checked');
				$("#overlay-button").removeClass( "transfer" );
				
		 });
		 $('#overlay-button').click(function () {
				if ($('#overlay').css('visibility') == 'visible' ) {
					$('#overlay').css('visibility', 'hidden').show(1000);
					// $("#overlay-input").attr('checked','checked');
					
					$("#overlay-button").removeClass( "transfer" );

				}else{
					$('#overlay').css('visibility', 'visible').show(1000);
					$("#overlay-button").addClass( "transfer" );
				}
		 });
	 }
	
	
	 $(".colorbox-gallery").colorbox({
		 rel:'colorbox-gallery', 
		 slideshow:true,
		 slideshowSpeed: 5000,
		 maxHeight:"98%",
		 maxWidth:"99%",
	 });

	 $(".colorbox-inline").colorbox({
		inline:true, 
		width:"98%", 
		rel:true,
		maxWidth: "700px",
		

	 });

	
	

});


jQuery(document).ready(function($){

	
	
	
	

    // Информационное сообщение на главном экране
    $('.infocatalog-not-oficial').show();
    $(window).scroll(function(){
        if ($(this).scrollTop() > 15) {
            $('.infocatalog-not-oficial').hide();
        } else {
            $('.infocatalog-not-oficial').show();
        }
    });
	


    // hide the topbutton on page load/ready.
    $('.d-top').show();

    //Check to see if the window is top if not then display button
    $(window).scroll(function(){
        if ($(this).scrollTop() > 15) {
            $('.d-top').hide();
			//$('.d-top').hide().fadeOut();	
        } else {
            $('.d-top').show();
			//$('.d-top').fadeIn().show();
        }
    });
	
	$('body').on({
		'touchmove': function(e) { 
			$('.d-top').hide();
		}
	});

   
 	var carouselnew = $("#carousel");

	carouselnew.owlCarousel({
		items: 1,
		loop: true,
		autoplay: true,
		 autoWidth:true,
		 center:true,
	});
	
	/*
	
	carouselnew.owlCarousel({
		loop: true,
		autoWidth:true,
		center:true,
		navigation : true, 
		autoPlay: true,
		autoplayTimeout: 500,
		autoplayHoverPause: true,
		responsiveClass:true,
		margin:10,
		
		items:1,
		
		responsive:{
			100:{
				items:1,
			},
			
			650:{
				items:2,
			},
			
			900:{
				items:3,
			},			
			1100:{
				items:4,

			},
			1400:{
				items:5,
			}			
		},
		
	});  
	*/
   

   	$('#js-prev').click(function () {
		// carouselnew.trigger('owl.prev');
		// return false;
		carouselnew.trigger('prev.owl.carousel');

		return false;		
	});


	$('#js-next').click(function () {
		// carouselnew.trigger('owl.next');
		// return false;
		carouselnew.trigger('next.owl.carousel');

		return false;
	});	

  	//$("#info-z-2").html('<div class="buythis"><a href="#">Купить этот сайт</a></div>');
	var width_val = $(document).width();
	//console.log(width_val);
	
	$(window).scroll(function (event) {

		 
		 var top = $(window).scrollTop();
		 //console.log(top);
		 
		 if( width_val>480 ){
			 if(top >= 15 ) 
			 {
						$('.desctop-adv').delay(1).css('display', 'none')
						$('.desctop-adv').delay(1).css('opacity', '0')
			 } else {
						$('.desctop-adv').delay(1).css('display', 'block')
						$('.desctop-adv').delay(1).css('opacity', '1')
			 }
		 }
		 else{
			 if(top >= 15) 
			 {
						$('.modile-adv').delay(1).css('display', 'none')
						$('.modile-adv').delay(1).css('opacity', '0')
			 } else {
						$('.modile-adv').delay(1).css('display', 'block')
						$('.modile-adv').delay(1).css('opacity', '1')
			 }		
		}		 
		 
		 
	});	
	
	


	
