/*cookie alert*/
class CookieAlert{constructor(config={}){this.config={cookieName:'cookies_accepted',expiryDays:365,showDelay:1000,...config};this.alertElement=null;this.isVisible=false;this.init()}init(){if(this.getCookie(this.config.cookieName))return;this.createAlert();setTimeout(()=>{this.show()},this.config.showDelay)}createAlert(){this.alertElement=document.createElement('div');this.alertElement.id='cookieAlert';this.alertElement.className='cookie-alert';this.alertElement.style.display='none';const content=document.createElement('div');content.className='cookie-alert-content';content.innerHTML=`Используя сайт, вы соглашаетесь на обработку cookies и данных согласно <a href="https://orgs.biz/privacy" target="_blank" rel="noopener">политике конфиденциальности</a>. <button class="cookie-alert-button" type="button">Принять</button>`;this.alertElement.appendChild(content);document.body.appendChild(this.alertElement);const button=this.alertElement.querySelector('.cookie-alert-button');button.addEventListener('click',()=>this.accept());const link=this.alertElement.querySelector('a');link.addEventListener('click',()=>{this.trackEvent('privacy_policy_clicked')})}show(){if(!this.alertElement||this.isVisible)return;this.alertElement.style.display='flex';this.alertElement.classList.remove('hidden');this.isVisible=true;this.addBodyPadding();this.trackEvent('cookie_alert_shown')}hide(){if(!this.alertElement||!this.isVisible)return;this.alertElement.classList.add('hidden');this.isVisible=false;this.removeBodyPadding();setTimeout(()=>{if(this.alertElement&&this.alertElement.parentNode){this.alertElement.parentNode.removeChild(this.alertElement);this.alertElement=null}},300)}accept(){this.setCookie(this.config.cookieName,'true',this.config.expiryDays);this.trackEvent('cookies_accepted');this.hide();if(typeof this.config.onAccept==='function'){this.config.onAccept()}}addBodyPadding(){if(!this.alertElement)return;const alertHeight=this.alertElement.offsetHeight;document.body.style.paddingBottom=`${alertHeight}px`;document.body.style.transition='padding-bottom 0.3s ease'}removeBodyPadding(){document.body.style.paddingBottom='';setTimeout(()=>{document.body.style.transition=''},300)}setCookie(name,value,days){const expires=new Date();expires.setTime(expires.getTime()+(days*24*60*60*1000));const domain=this.getBaseDomain();document.cookie=`${name}=${value};expires=${expires.toUTCString()};path=/;domain=${domain};SameSite=Lax`}getBaseDomain(){const hostname=window.location.hostname;const parts=hostname.split('.');if(parts.length<=2){return hostname}return '.'+parts.slice(-2).join('.')}getCookie(name){const nameEQ=name+"=";const ca=document.cookie.split(';');for(let i=0;i<ca.length;i++){let c=ca[i];while(c.charAt(0)===' ')c=c.substring(1,c.length);if(c.indexOf(nameEQ)===0)return c.substring(nameEQ.length,c.length)}return null}trackEvent(eventName){if(typeof gtag!=='undefined'){gtag('event',eventName,{event_category:'cookie_consent',event_label:'cookie_alert'})}if(typeof ym!=='undefined'&&window.YANDEX_METRIKA_ID){ym(window.YANDEX_METRIKA_ID,'reachGoal',eventName)}console.log(`Cookie Alert Event: ${eventName}`)}forceShow(){if(!this.alertElement){this.createAlert()}this.show()}forceHide(){this.hide()}reset(){this.setCookie(this.config.cookieName,'',-1);this.forceShow()}}document.addEventListener('DOMContentLoaded',function(){const config={showDelay:1500,onAccept:function(){console.log('Cookies accepted!')}};window.cookieAlert=new CookieAlert(config)});window.CookieAlertUtils={show:()=>window.cookieAlert?.forceShow(),hide:()=>window.cookieAlert?.forceHide(),reset:()=>window.cookieAlert?.reset(),isAccepted:()=>{const cookie=document.cookie.split(';').find(c=>c.trim().startsWith('cookies_accepted='));return cookie&&cookie.split('=')[1]==='true'}};


// static/js/edit-links.js

(function() {
    'use strict';
    
    /**
     * Получает значение куки по имени
     * @param {string} name - Имя куки
     * @returns {string|null}
     */
    function getCookie(name) {
        const value = `; ${document.cookie}`;
        const parts = value.split(`; ${name}=`);
        if (parts.length === 2) {
            return parts.pop().split(';').shift();
        }
        return null;
    }
    
    /**
     * Проверяет, является ли ссылка внутренней
     * @param {string} href - URL ссылки
     * @returns {boolean}
     */
    function isInternalLink(href) {
        if (!href) return false;
        
        // Пропускаем якоря, mailto, tel и javascript
        if (href.startsWith('#') || 
            href.startsWith('mailto:') || 
            href.startsWith('tel:') ||
            href.startsWith('javascript:')) {
            return false;
        }
        
        return true;
    }
    
    /**
     * Добавляет параметр edit=1 к URL
     * @param {string} url - Исходный URL
     * @returns {string} - URL с параметром edit=1
     */
    function addEditParam(url) {
        try {
            const urlObj = new URL(url, window.location.origin);
            
            // Проверяем, что это тот же домен (субдомен)
            if (urlObj.hostname !== window.location.hostname) {
                return url;
            }
            
            // Добавляем параметр edit=1, если его еще нет
            if (!urlObj.searchParams.has('edit')) {
                urlObj.searchParams.set('edit', '1');
            }
            
            return urlObj.toString();
        } catch (e) {
            // Если URL относительный
            const separator = url.includes('?') ? '&' : '?';
            if (!url.includes('edit=')) {
                return url + separator + 'edit=1';
            }
            return url;
        }
    }
    
    /**
     * Обрабатывает одну ссылку
     * @param {HTMLAnchorElement} link - Элемент ссылки
     */
    function processLink(link) {
        const href = link.getAttribute('href');
        
        if (isInternalLink(href)) {
            const newHref = addEditParam(href);
            if (newHref !== href) {
                link.setAttribute('href', newHref);
            }
        }
    }
    
    /**
     * Обрабатывает все ссылки на странице
     */
    function processAllLinks() {
        const editCookie = getCookie('edit');
        
        // Проверяем наличие куки edit=true
        if (editCookie !== 'true') {
            console.log('⏸️ Edit cookie не найдена, ссылки не обрабатываются');
            return;
        }
        
        const links = document.querySelectorAll('a[href]');
        let processedCount = 0;
        
        links.forEach(link => {
            const originalHref = link.getAttribute('href');
            processLink(link);
            const newHref = link.getAttribute('href');
            
            if (originalHref !== newHref) {
                processedCount++;
            }
        });
        
        console.log(`✅ Обработано ссылок: ${processedCount} из ${links.length}`);
    }
    
    /**
     * Наблюдает за добавлением новых элементов в DOM
     */
    function observeDOM() {
        const editCookie = getCookie('edit');
        
        if (editCookie !== 'true') {
            return;
        }
        
        const observer = new MutationObserver(function(mutations) {
            // Проверяем куку при каждом изменении
            const currentEditCookie = getCookie('edit');
            if (currentEditCookie !== 'true') {
                return;
            }
            
            mutations.forEach(function(mutation) {
                mutation.addedNodes.forEach(function(node) {
                    // Обрабатываем только элементы
                    if (node.nodeType === 1) {
                        // Если добавленный элемент - это ссылка
                        if (node.tagName === 'A' && node.hasAttribute('href')) {
                            processLink(node);
                        }
                        
                        // Ищем ссылки внутри добавленного элемента
                        const links = node.querySelectorAll('a[href]');
                        links.forEach(link => processLink(link));
                    }
                });
            });
        });
        
        // Начинаем наблюдение
        observer.observe(document.body, {
            childList: true,
            subtree: true
        });
        
        console.log('👁️ Наблюдение за динамическими ссылками активировано');
    }
    
    /**
     * Инициализация скрипта
     */
    function init() {
        const editCookie = getCookie('edit');
        
        if (editCookie === 'true') {
            console.log('🔧 Режим редактирования активен, обрабатываем ссылки...');
            
            // Обрабатываем существующие ссылки после загрузки DOM
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', processAllLinks);
            } else {
                processAllLinks();
            }
            
            // Запускаем наблюдение за новыми ссылками
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', observeDOM);
            } else {
                observeDOM();
            }
        } else {
            console.log('⏸️ Режим редактирования не активен');
        }
    }
    
    // Запускаем инициализацию
    init();
    
    console.log('🔗 Скрипт обработки ссылок загружен');
})();
